{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open Source Autopilot Configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "tokenEnv": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
    "apiBaseUrl": { "type": "string", "format": "uri" },
    "pollSeconds": { "type": "integer", "minimum": 60, "maximum": 86400 },
    "claimPollSeconds": { "type": "integer", "minimum": 60, "maximum": 86400 },
    "claimFollowUpHours": { "type": "number", "minimum": 1, "maximum": 720 },
    "maxClaimFollowUps": { "type": "integer", "minimum": 0, "maximum": 5 },
    "autoMerge": { "type": "boolean" },
    "mergeMethod": { "type": "string", "enum": ["squash", "merge", "rebase"] },
    "fork": { "type": "boolean" },
    "requireAssignment": { "type": "boolean" },
    "gitAuthorName": { "type": "string", "maxLength": 120 },
    "gitAuthorEmail": { "type": "string", "maxLength": 200 },
    "disclosure": { "type": "string", "maxLength": 600 },
    "dryRun": { "type": "boolean" },
    "enforceDisclosure": { "type": "boolean" },
    "prLabels": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 50 }, "maxItems": 20 },
    "usePrTemplate": { "type": "boolean" }
  }
}